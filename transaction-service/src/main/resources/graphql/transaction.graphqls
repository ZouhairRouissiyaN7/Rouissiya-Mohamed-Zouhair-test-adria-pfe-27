"""Transaction bancaire enregistrée sur un compte"""
type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
    createdAt: String!
}

"""Données nécessaires à l'enregistrement d'une transaction"""
input CreateTransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

type Query {
    """Consultation d'une transaction par son identifiant"""
    transaction(id: ID!): Transaction!
    """Transactions d'un compte, les plus récentes en premier"""
    transactionsByAccount(accountId: ID!, page: Int = 0, size: Int = 20): [Transaction!]!
}

type Mutation {
    """Enregistrement d'une transaction sur un compte"""
    createTransaction(input: CreateTransactionInput!): Transaction!
}
